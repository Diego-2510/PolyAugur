# PolyAugur Environment Variables
# Copy this file to .env and fill in only the integrations you want to use:
#   cp .env.example .env

# Optional: required only for live Mistral-assisted review.
# Offline tests, fixtures, evaluation, and Docker smoke tests do not require it.
MISTRAL_API_KEY=

# Optional: Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: custom SQLite path (default: data/signals.db).
# SIGNAL_DB_PATH=data/signals.db